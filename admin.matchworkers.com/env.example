
# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=****************************
API_TOKEN_SALT=*****************
ADMIN_JWT_SECRET=****************************
TRANSFER_TOKEN_SALT=*****************
ENCRYPTION_KEY=****************************

# Database
DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=*************
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_FILENAME=
JWT_SECRET=*********************




# Backup schedule
#npm install strapi-plugin-backup
#./config/plugins.js
#which mysqldump
#console.aws.amazon.com/console/home   Id or alies not have then go to root user



#run at 4 AM every day
BACKUP_CRON=0 4 * * *     

# every 5 minutes for testing
#BACKUP_CRON=*/2 * * * *
 

# Storage
BACKUP_STORAGE=aws-s3

# AWS
AWS_ACCESS_KEY_ID=********************
AWS_SECRET_ACCESS_KEY=********************
AWS_REGION=*********************
AWS_S3_BUCKET=amzn-******************

# MySQL dump path  live
MYSQLDUMP_PATH=/usr/bin/mysqldump

# MySQL dump path  localhost testing
#MYSQLDUMP_PATH="D:/xampp/mysql/bin/mysqldump.exe"

# Cleanup
#10 days = 10 × 24 × 60 × 60 = 864000 seconds
BACKUP_ALLOW_CLEANUP=true
BACKUP_KEEP_SECONDS=864000
#run at 6 AM every day
BACKUP_CLEANUP_CRON=0 6 * * * 